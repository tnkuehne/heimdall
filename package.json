{
  "name": "meeting-recorder-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf build/extension && tsc --project tsconfig.json && cp extension/metadata.json build/extension/metadata.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run settings:check && pnpm run dbus:check",
    "check:integration": "./scripts/check-dbus.sh",
    "dbus:check": "node tools/generate-dbus-client.mjs --check",
    "dbus:generate": "node tools/generate-dbus-client.mjs",
    "format": "oxfmt extension tests tools/generate-dbus-client.mjs",
    "format:check": "oxfmt --check extension tests tools/generate-dbus-client.mjs",
    "lint": "oxlint --deny-warnings extension tests",
    "lint:fix": "oxlint --fix extension tests",
    "settings:check": "./scripts/check-settings.sh",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@girs/gnome-shell": "46.0.2",
    "@oxlint/plugins": "1.80.0",
    "@tsconfig/strictest": "^2.0.8",
    "fast-xml-parser": "5.11.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.1.3"
}
