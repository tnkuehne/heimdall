{
  "name": "meeting-recorder-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json && cp extension/metadata.json build/extension/metadata.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "format": "oxfmt extension",
    "format:check": "oxfmt --check extension",
    "lint": "oxlint --deny-warnings extension",
    "lint:fix": "oxlint --fix extension",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@girs/gnome-shell": "46.0.2",
    "@oxlint/plugins": "1.80.0",
    "@tsconfig/strictest": "^2.0.8",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.1.3"
}
